# /etc/systemd/system/kiosk.service auf dem Pi im Barraum (Stand 03.10.2026, zeigt auf die Barraum-Weiche)
[Unit]
Description=Kiosk Setup
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk-admin
PAMName=login
RuntimeDirectory=cage-kiosk
Environment="XDG_RUNTIME_DIR=/run/cage-kiosk"
Environment="WLR_LIBINPUT_NO_DEVICES=1"
Environment="WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1"
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYHangup=yes
TTYVTDisallocate=yes
TimeoutStartSec=infinity
ExecStartPre=/bin/sh -c 'while ! ping -c 1 -W 2 vielbunt.org >/dev/null 2>&1; do sleep 5; done'
# Startet den Browser im Kiosk-Modus
#ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --no-memcheck --lang=de --enable-gpu-rasterization --enable-zero-copy --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream --use-fake-device-for-media-stream --restore-last-session=false --memory-pressure-off --incognito --disable-infobars --disable-translate   --disable-features=TranslateUI,Translate --disable-notifications --noerrdialogs --ignore-gpu-blocklist file:///home/kiosk-admin/kiosk-test.html
#ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --no-memcheck --lang=de --enable-gpu-rasterization --enable-zero-copy --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream --use-fake-device-for-media-stream --restore-last-session=false --memory-pressure-off --incognito --disable-infobars --disable-translate   --disable-features=TranslateUI,Translate --disable-notifications --noerrdialogs --ignore-gpu-blocklist https://www.vielbunt.org/kiosk.html?animation=false
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --no-memcheck --lang=de --enable-gpu-rasterization --enable-zero-copy --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream --use-fake-device-for-media-stream --restore-last-session=false --memory-pressure-off --incognito --disable-infobars --disable-translate   --disable-features=TranslateUI,Translate --disable-notifications --noerrdialogs --ignore-gpu-blocklist file:///home/kiosk-admin/barraum/start.html
#ExecStart=/usr/bin/cage -s -- /usr/bin/cog file:///home/kiosk-admin/kiosk-cog.html
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
